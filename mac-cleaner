    st_pick "Numéros à désactiver (vide = rien)" st_ask "Désactiver %s élément(s) ?"
    st_note "Une app peut réinstaller son service à son prochain lancement ; la désinstaller est plus propre."
    st_done "%s élément(s) désactivé(s)"
    du_dir "Dossier à analyser, vide = ton dossier personnel" du_spin "Comparaison des fichiers…"
    du_none "Aucun doublon trouvé." du_bad "Dossier introuvable : %s" du_group "Groupe %s · %s × %s"
    du_keep garde du_pick "Groupes à nettoyer (ex. 1 3), « t » = tout, vide = rien"
    du_ask "Mettre %s copie(s) (%s) à la corbeille ? Le plus ancien fichier de chaque groupe est gardé."
    du_done "%s de doublons envoyés à la corbeille"
    hi_empty "Rien encore." hi_total "Libéré au total : %s"
    usage "Usage : %s [commande] [--dry-run] [--yes]"
    u_ram "libérer la mémoire inactive" u_trash "vider la corbeille" u_un "désinstaller une app et ses fichiers"
    u_lg "chercher les gros fichiers" u_ca "nettoyer les caches (apps, dev, Homebrew, Docker, node_modules)"
    u_dl "vieux fichiers de Téléchargements" u_st "apps et services lancés au démarrage" u_du "fichiers en double"
    u_auto "tout ce qui est sans risque en un passage" u_hist "ce qui a été libéré, et quand"
    u_menu "(sans commande : menu interactif)"
    u_dry "--dry-run, -n   aperçu : montre ce qui serait fait, sans rien supprimer"
    u_yes "--yes, -y       ne demande pas de confirmation"
  )
else
  T=(
    gb GB mb MB kb KB yes '[yY]*' yn y/N all_key '[aA]*'
    tagline "tidy up your Mac, the essentials"
    disk Disk ram RAM disk_free "%s free" ram_free "%s%% free"
    m1 "Free up RAM" m2 "Empty the Trash" m3 "Uninstall an app"
    m4 "Find large files" m5 "Clean caches" m6 "Old downloads"
    m7 "Startup (apps and services)" m8 "Duplicate files" m9 "Auto clean" mh History
    mq Quit bye "See you soon."
    back "[ press any key to return to the menu ]"
    dry_badge "DRY RUN · nothing will be deleted" dry_line "[dry run] %s" dry_done "Dry run finished: nothing was deleted."
    ram_free_now "Free memory: %s%%" top_procs "Top memory consumers"
    ram_ask "Free inactive memory (sudo purge)?" sudo_prompt "admin password:"
    ram_spin "Purging memory…" ram_done "Free RAM: %s%% → %s%%"
    trash_title Trash trash_spin "Measuring the Trash…" trash_size "Trash size: %s"
    trash_zero "(0 may also mean Terminal lacks Full Disk Access)"
    trash_ask "Empty the Trash (permanent)?" trash_emptying "Emptying…" trash_done "Trash emptied · %s reclaimed"
    trash_fail "Failed: allow Terminal to control Finder (Settings › Privacy › Automation)."
    un_filter "Name (or part of it), empty = all" un_none "No app found."
    un_pick "App number (empty = cancel)" un_apple "Apple system app, skipped."
    un_spin "Looking for %s files…" total "Total: %s"
    un_ask "Move all of this to the Trash?" un_done "%s uninstalled · %s (recoverable from the Trash)"
    mv_fail "Could not move: %s"
    lg_min "Minimum size in MB" lg_spin "Scanning ~ (excluding ~/Library)…"
    lg_none "No file larger than %s MB." pick "Numbers to move to the Trash (e.g. 1 3 5), \"a\" = all, empty = none"
    lg_ask "Move %s file(s) (%s) to the Trash?" lg_done "%s moved to the Trash"
    ca_title "Caches and temporary files" ca_spin "Analyzing caches…"
    ca_pick "Numbers to clean (e.g. 1 3), \"a\" = all, empty = none"
    ca_done "About %s freed" ca_note "(running apps will rebuild part of their caches)"
    c_apps "App caches" c_logs "Logs" c_xcode "Xcode DerivedData" c_devsupport "Xcode iOS DeviceSupport"
    c_sim "iOS Simulator caches" c_npm "npm cache" c_composer "Composer cache" c_gradle "Gradle caches"
    c_brew "Homebrew (old versions, downloads)" c_docker "Docker (unused images, stopped containers)"
    c_nodemod "node_modules idle for 90 days (%s project(s))"
    au_desc "Only what is safe: caches, logs, dev caches, Homebrew, Trash."
    au_ask "Clean everything?"
    dl_days "Older than how many days" dl_spin "Scanning ~/Downloads…"
    dl_none "Nothing older than %s days in Downloads." dl_age "%s d"
    st_spin "Reading startup items…" st_login "login item" st_agent "user agent"
    st_sysagent "system agent" st_daemon "system service" st_none "Nothing launches at startup besides macOS."
    st_pick "Numbers to disable (empty = none)" st_ask "Disable %s item(s)?"
    st_note "An app may reinstall its service on next launch; uninstalling it is cleaner."
    st_done "%s item(s) disabled"
    du_dir "Folder to scan, empty = your home folder" du_spin "Comparing files…"
    du_none "No duplicates found." du_bad "Folder not found: %s" du_group "Group %s · %s × %s"
    du_keep keep du_pick "Groups to clean (e.g. 1 3), \"a\" = all, empty = none"
    du_ask "Move %s copy(ies) (%s) to the Trash? The oldest file of each group is kept."
    du_done "%s of duplicates moved to the Trash"
    hi_empty "Nothing yet." hi_total "Freed in total: %s"
    usage "Usage: %s [command] [--dry-run] [--yes]"
    u_ram "free inactive memory" u_trash "empty the Trash" u_un "uninstall an app and its files"
    u_lg "find large files" u_ca "clean caches (apps, dev, Homebrew, Docker, node_modules)"
    u_dl "old files in Downloads" u_st "apps and services launched at startup" u_du "duplicate files"
    u_auto "everything safe in one pass" u_hist "what was freed, and when"
    u_menu "(no command: interactive menu)"
    u_dry "--dry-run, -n   preview what would be done, delete nothing"
    u_yes "--yes, -y       do not ask for confirmation"
  )
fi

t() { local k=$1; shift; printf -- "$T[$k]" "$@" }

human() {
  local k=${1:-0}
  if (( k >= 1048576 )); then printf "%.1f $T[gb]" $(( k / 1048576.0 ))
  elif (( k >= 1024 )); then printf "%.1f $T[mb]" $(( k / 1024.0 ))
  else printf "%d $T[kb]" $k; fi
}

sizek() { (( $# )) || { echo 0; return }; du -sk "$@" 2>/dev/null | awk '{s+=$1} END{print s+0}' }

to_kb() {
  awk -v s="$1" 'BEGIN {
    if (!match(s, /[0-9.]+/)) { print 0; exit }
    n = substr(s, RSTART, RLENGTH); u = toupper(substr(s, RSTART + RLENGTH)); m = 1 / 1024
    if (u ~ /^ *K/) m = 1; else if (u ~ /^ *M/) m = 1024; else if (u ~ /^ *G/) m = 1048576; else if (u ~ /^ *T/) m = 1073741824
    printf "%d\n", n * m
  }'
}

bar() {
  local val=$1 max=$2 width=${3:-20} col=${4:-$C}
  (( max > 0 )) || max=1
  local fill=$(( val * width / max ))
  (( val > 0 && fill == 0 )) && fill=1
  (( fill > width )) && fill=$width
  print -n "${col}${(l:fill::█:)}${N}${D}${(l:width-fill::░:)}${N}"
}

gauge_col() { (( $1 >= 85 )) && print -n $R || { (( $1 >= 60 )) && print -n $Y || print -n $G } }

star_line() {
  local w=${1:-44} line="" i
  for (( i = 0; i < w; i++ )); do
    if (( RANDOM % 9 == 0 )); then
      line+="\e[38;5;$(( RANDOM % 2 ? 228 : 255 ))m${STARS[RANDOM % ${#STARS} + 1]}${N}"
    else
      line+=" "
    fi
  done
  print -n "  $line"
}

LOGO=(
  "┌┬┐┌─┐┌─┐   ┌─┐┬  ┌─┐┌─┐┌┐┌┌─┐┬─┐"
  "│││├─┤│  ───│  │  ├┤ ├─┤│││├┤ ├┬┘"
  "┴ ┴┴ ┴└─┘   └─┘┴─┘└─┘┴ ┴┘└┘└─┘┴└─"
)

logo_lines() {
  local l i w=${#LOGO[1]} out
  for l in $LOGO; do
    out="     "
    for (( i = 1; i <= ${#l}; i++ )); do
      if [[ -n $FANCY ]]; then out+="\e[38;5;${GRAD[(i - 1) * ${#GRAD} / w + 1]}m${l[i]}"
      else out+=${l[i]}; fi
    done
    print "$out${N}"
  done
}

draw_logo() {
  if [[ -z $FANCY ]]; then logo_lines; return; fi
  local logo=$(logo_lines) f frames=${1:-1}
  print -n "\e[?25l"
  for (( f = 1; f <= frames; f++ )); do
    (( f > 1 )) && print -n "\e[6A"
    star_line; print
    print "$logo"
    star_line; print
    print "     ${D}v$VERSION · $T[tagline]${N}"
    (( f < frames )) && sleep 0.07
  done
  print -n "\e[?25h"
}

spin() {
  local msg=$1; shift
  if [[ -z $FANCY ]]; then "$@"; return; fi
  local tmp=$(mktemp -t mac-cleaner)
  "$@" >$tmp 2>/dev/null &
  local pid=$! i=0 frames=(✶ ✷ ✸ ✹ ✺ ✹ ✸ ✷)
  print -n "\e[?25l" >&2
  while kill -0 $pid 2>/dev/null; do
    printf "\r  ${Y}%s${N} ${D}%s${N}" ${frames[i++ % ${#frames} + 1]} "$msg" >&2
    sleep 0.08
  done
  wait $pid
  print -n "\r\e[2K\e[?25h" >&2
  cat $tmp; rm -f $tmp
}

confirm() {
  if [[ -n $YES || -n $DRY_RUN ]]; then print "  ${M}?${N} $1 ${M}›${N} ${D}(${${DRY_RUN:+--dry-run}:---yes})${N}"; return 0; fi
  local r; read "r?  ${M}?${N} $1 ${D}($T[yn])${N} ${M}›${N} "; [[ $r == ${~T[yes]} ]]
}

ask() { local __v; read "__v?  ${M}?${N} $2 ${M}›${N} "; : ${(P)1::=$__v} }

key() {
  local __k
  if [[ -t 0 ]]; then read -s -k1 "__k?$2"; else read -k1 -u0 "__k?$2"; fi || return 1
  : ${(P)1::=$__k}
}

pause() { local r; key r "  ${D}$T[back]${N}"; print }

pick_idx() {
  local sel=$1 n=$2 i
  (( n > 0 )) || return 0
  if [[ $sel == ${~T[all_key]} ]]; then seq 1 $n; return; fi
  for i in ${(u)=sel}; do [[ $i == <1-> && $i -le $n ]] && print $i; done
}

title() {
  local t=" ✦ $1 " w=56
  print "\n  ${M}${B}${t}${N}${D}${(l:w-${#t}::─:)}${N}\n"
  [[ -n $DRY_RUN ]] && print "  ${Y}✦ $T[dry_badge]${N}\n"
}

ok() { print "  ${G}✔${N} $*" }
warn() { print "  ${Y}!${N} $*" }
err() { print "  ${R}✘${N} $*" }
dry() { print "  ${D}$(t dry_line "$*")${N}" }

act_q() {
  if [[ -n $DRY_RUN ]]; then dry "$*"; return 0; fi
  "$@" >/dev/null 2>&1
}

celebrate() {
  local msg=$1 f
  if [[ -n $DRY_RUN ]]; then ok "$T[dry_done]"; return; fi
  if [[ -z $FANCY ]]; then print "  * $msg *"; return; fi
  local -a cols=(228 221 215 213 177 141 117 228)
  print -n "\e[?25l"
  for f in {1..8}; do
    printf "\r  \e[38;5;%dm★ ✦ ⋆${N}  ${B}%s${N}  \e[38;5;%dm⋆ ✦ ★${N}" ${cols[f]} "$msg" ${cols[9-f]}
    sleep 0.06
  done
  print "\e[?25h"
}

log_hist() {
  [[ -n $DRY_RUN ]] && return 0
  mkdir -p ${HIST_FILE:h} 2>/dev/null
  print -r -- "$(date '+%F %H:%M')	$1	${2:-0}	$3" >> $HIST_FILE
}

to_trash() {
  local p dest
  for p in "$@"; do
    [[ -e $p ]] || continue
    if [[ -n $DRY_RUN ]]; then dry "→ $T[trash_title] : ${p/#$HOME/~}"; continue; fi
    if [[ -n $MAC_CLEANER_TRASH_DIR ]]; then
      dest=$MAC_CLEANER_TRASH_DIR/${p:t}
      [[ -e $dest ]] && dest+=" $RANDOM"
      mv "$p" "$dest" 2>/dev/null || err "$(t mv_fail "$p")"
    else
      trash "$p" 2>/dev/null || osascript -e "tell application \"Finder\" to delete POSIX file \"$p\"" >/dev/null 2>&1 \
        || sudo mv "$p" "$TRASH_DIR/" 2>/dev/null || err "$(t mv_fail "$p")"
    fi
  done
}

empty_trash() {
  if [[ -n $DRY_RUN ]]; then dry "$T[trash_ask]"; return 0; fi
  if [[ -n $MAC_CLEANER_TRASH_DIR ]]; then rm -rf "$MAC_CLEANER_TRASH_DIR"/*(DN)
  else osascript -e 'tell application "Finder" to empty trash' >/dev/null 2>&1; fi
}

disk_stats() { df -k /System/Volumes/Data | awk 'NR==2{print $2, $4}' }

mem_free() { memory_pressure 2>/dev/null | awk -F': ' '/free percentage/{gsub("%","",$2); print $2}' }

overview() {
  local -a ds=( $(disk_stats) )
  local dpct=$(( (ds[1] - ds[2]) * 100 / ds[1] )) mfree=$(mem_free)
  local mpct=$(( 100 - ${mfree:-0} ))
  printf "\n  ${D}%-6s${N}  %s ${B}%3d%%${N} ${D}· %s${N}\n" "$T[disk]" "$(bar $dpct 100 24 $(gauge_col $dpct))" $dpct "$(t disk_free "$(human $ds[2])")"
  printf "  ${D}%-6s${N}  %s ${B}%3d%%${N} ${D}· %s${N}\n" "$T[ram]" "$(bar $mpct 100 24 $(gauge_col $mpct))" $mpct "$(t ram_free "$mfree")"
}

do_ram() {
  title "$T[ram]"
  local before=$(mem_free)
  print "  ${B}$(t ram_free_now $before)${N}\n"
  print "  ${D}$T[top_procs]${N}"
  local -a procs=( ${(f)"$(ps -axmo rss=,comm= | head -8)"} )
  local max=${${procs[1]## #}%% *} p rss cmd
  for p in $procs; do
    rss=${${p## #}%% *}; cmd=${${p## #}#* }
    printf "  %s %9s  %s\n" "$(bar $rss $max 16 $M)" "$(human $rss)" "${cmd:t}"
  done
  print
  confirm "$T[ram_ask]" || return 0
  if [[ -n $DRY_RUN ]]; then dry "sudo purge"; celebrate; return 0; fi
  sudo -p "  ${D}$T[sudo_prompt]${N} " true || return 0
  spin "$T[ram_spin]" sudo purge
  local after=$(mem_free)
  log_hist m1 0 "$before% → $after%"
  celebrate "$(t ram_done $before $after)"
}

do_trash() {
  title "$T[trash_title]"
  local k=$(spin "$T[trash_spin]" sizek $TRASH_DIR/*(DN))
  print "  $(t trash_size "${B}$(human $k)${N}")"
  (( k == 0 )) && print "  ${D}$T[trash_zero]${N}"
  print
  confirm "$T[trash_ask]" || return 0
  if [[ -n $DRY_RUN ]]; then empty_trash; celebrate; return 0; fi
  if spin "$T[trash_emptying]" empty_trash; then
    log_hist m2 $k
    celebrate "$(t trash_done "$(human $k)")"
  else
    err "$T[trash_fail]"
  fi
}

LIB_DIRS=(
  ~/Library/"Application Support" ~/Library/Caches ~/Library/Preferences ~/Library/Containers
  ~/Library/"Group Containers" ~/Library/Logs ~/Library/"Saved Application State" ~/Library/HTTPStorages
  ~/Library/WebKit ~/Library/LaunchAgents ~/Library/Cookies ~/Library/"Application Scripts"
  /Library/"Application Support" /Library/Caches /Library/Preferences /Library/LaunchAgents /Library/LaunchDaemons
)

leftovers() {
  local app=$1 name=$2 bid=$3 d
  local -a expr
  [[ -n $bid ]] && expr=( -name "$bid" -o -name "$bid.*" -o -name "*.$bid" -o -name "*.$bid.*" -o )
  print -r -- "$app"
  for d in $LIB_DIRS; do
    [[ -d $d ]] || continue
    find "$d" -mindepth 1 -maxdepth 1 \( $expr -iname "$name" -o -iname "$name.*" \) 2>/dev/null
  done
}

do_uninstall() {
  title "$T[m3]"
  local filter
  ask filter "$T[un_filter]"
  local -a apps
  apps=( /Applications/*.app ~/Applications/*.app )
  [[ -n $filter ]] && apps=( ${(M)apps:#(#i)*${filter}*} )
  (( ${#apps} )) || { warn "$T[un_none]"; return 0 }
  print
  local i=1 a
  for a in $apps; do printf "  ${M}%3d${N}  %s\n" $i "${a:t:r}"; (( i++ )); done
  print
  local n
  ask n "$T[un_pick]"
  [[ $n == <1-> && $n -le ${#apps} ]] || return 0
  local app=$apps[$n] name=${apps[$n]:t:r}
  local bid=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist" 2>/dev/null)
  [[ $bid == com.apple.* ]] && { err "$T[un_apple]"; return 0 }

  local -a found=( ${(u)${(f)"$(spin "$(t un_spin $name)" leftovers "$app" "$name" "$bid")"}:#} )
  local -a sizes
  local f max=0 total=0 k
  for f in $found; do k=$(sizek "$f"); sizes+=( $k ); (( total += k, k > max ? (max = k) : 0 )); done

  print "\n  ${B}$name${N} ${D}· $bid${N}\n"
  for i in {1..${#found}}; do
    printf "  %s %9s  %s\n" "$(bar ${sizes[i]} $max 12)" "$(human ${sizes[i]})" "${found[i]/#$HOME/~}"
  done
  print "\n  ${B}$(t total "$(human $total)")${N}\n"
  confirm "$T[un_ask]" || return 0
  [[ -n $bid && -z $DRY_RUN ]] && osascript -e "quit app id \"$bid\"" >/dev/null 2>&1
  to_trash $found
  log_hist m3 $total "$name"
  celebrate "$(t un_done $name "$(human $total)")"
}

large_scan() {
  local min=$1 f
  find "$HOME" -xdev \( -path "$HOME/Library" -o -path "$HOME/.Trash" -o -name "*.app" \) -prune -o -type f -size +${min}M -print 2>/dev/null \
    | while IFS= read -r f; do print -r -- "$(stat -f '%z' "$f")	$f"; done \
    | sort -t$'\t' -k1,1nr | head -40
}

do_large() {
  title "$T[m4]"
  local min
  ask min "$T[lg_min] ${D}[500]${N}"
  [[ $min == <1-> ]] || min=500
  local -a rows=( ${(f)"$(spin "$T[lg_spin]" large_scan $min)"} )
  rows=( ${rows:#} )
  (( ${#rows} )) || { warn "$(t lg_none $min)"; return 0 }
  local -a paths psz
  local i=1 r max=${rows[1]%%$'\t'*} sz
  for r in $rows; do
    paths+=( "${r#*$'\t'}" ); sz=${r%%$'\t'*}; psz+=( $(( sz / 1024 )) )
    printf "  ${M}%3d${N} %s %9s  %s\n" $i "$(bar $(( sz / 1024 )) $(( max / 1024 )) 12)" "$(human $(( sz / 1024 )))" "${${r#*$'\t'}/#$HOME/~}"
    (( i++ ))
  done
  print
  local sel
  ask sel "$T[pick]"
  local -a pick
  local k=0
  for i in $(pick_idx "$sel" ${#paths}); do pick+=( "${paths[i]}" ); (( k += psz[i] )); done
  (( ${#pick} )) || return 0
  confirm "$(t lg_ask ${#pick} "$(human $k)")" || return 0
  to_trash $pick
  log_hist m4 $k
  celebrate "$(t lg_done "$(human $k)")"
}

CACHE_KEYS=(apps logs xcode devsupport sim npm composer gradle brew docker nodemod)
SAFE_KEYS=(apps logs xcode sim npm composer gradle brew)
typeset -A CDIR
CDIR=(
  apps "$HOME/Library/Caches" logs "$HOME/Library/Logs" xcode "$HOME/Library/Developer/Xcode/DerivedData"
  devsupport "$HOME/Library/Developer/Xcode/iOS DeviceSupport" sim "$HOME/Library/Developer/CoreSimulator/Caches"
  npm "$HOME/.npm/_cacache" composer "$HOME/.composer/cache" gradle "$HOME/.gradle/caches"
)

cache_avail() {
  [[ " $MAC_CLEANER_SKIP " == *" $1 "* ]] && return 1
  case $1 in
    brew) (( $+commands[brew] )) ;;
    docker) (( $+commands[docker] )) && docker info >/dev/null 2>&1 ;;
    nodemod) return 0 ;;
    *) [[ -d $CDIR[$1] ]] ;;
  esac
}

brew_kb() { to_kb "$(brew cleanup -n -s 2>/dev/null | awk '/free approximately/{print $(NF-3)}')" }

docker_kb() {
  local l s=0
  for l in ${(f)"$(docker system df --format '{{.Type}}|{{.Reclaimable}}' 2>/dev/null)"}; do
    [[ $l == Local\ Volumes* || -z $l ]] && continue
    (( s += $(to_kb "${${l#*|}%% *}") ))
  done
  print $s
}

nm_scan() {
  local root nm
  for root in ${(s.:.)${MAC_CLEANER_PROJECTS:-$HOME}}; do
    [[ -d $root ]] || continue
    find "$root" -maxdepth 6 \( -path "$HOME/Library" -o -path "$HOME/.Trash" -o -name .git \) -prune -o -type d -name node_modules -prune -print 2>/dev/null
  done | while IFS= read -r nm; do
    [[ -z $(find "${nm:h}" -mindepth 1 -maxdepth 2 -not -path '*/node_modules*' -not -path '*/.git*' -mtime -90 -print -quit 2>/dev/null) ]] && print -r -- "$nm"
  done
}

nm_paths() { local -a l=( ${(f)"$(<$NM_LIST)"} ); print -rl -- ${l:#} }

cache_kb() {
  case $1 in
    brew) brew_kb ;;
    docker) docker_kb ;;
    nodemod) nm_scan > $NM_LIST; local -a l=( ${(f)"$(nm_paths)"} ); sizek ${l:#} ;;
    *) sizek $CDIR[$1]/*(DN) ;;
  esac
}

scan_caches() { local k; for k in "$@"; do cache_avail $k && print -r -- "$k	$(cache_kb $k)"; done }

cache_label() {
  if [[ $1 == nodemod ]]; then local -a l=( ${(f)"$(nm_paths)"} ); t c_nodemod ${#${l:#}}
  else print -n "$T[c_$1]"; fi
}

cache_clean() {
  local k=$1 d
  case $k in
    brew) act_q brew cleanup -s ;;
    docker) act_q docker system prune -af ;;
    nodemod) for d in ${(f)"$(nm_paths)"}; do [[ $d == */node_modules ]] && act_q rm -rf "$d"; done ;;
    *)
      d=$CDIR[$k]
      [[ -d $d && $d == $HOME/?* ]] || return 0
      if [[ -n $DRY_RUN ]]; then dry "rm -rf ${d/#$HOME/~}/*"; else rm -rf "$d"/*(DN) 2>/dev/null; fi
      ;;
  esac
}

do_caches() {
  title "$T[ca_title]"
  NM_LIST=$(mktemp -t mac-cleaner)
  local -a rows=( ${(f)"$(spin "$T[ca_spin]" scan_caches $CACHE_KEYS)"} ) keys sizes
  rows=( ${rows:#} )
  local r i total=0 max=0
  for r in $rows; do keys+=( ${r%%$'\t'*} ); sizes+=( ${r#*$'\t'} ); done
  (( ${#keys} )) || { rm -f $NM_LIST; return 0 }
  for i in {1..${#keys}}; do (( total += sizes[i], sizes[i] > max ? (max = sizes[i]) : 0 )); done
  for i in {1..${#keys}}; do
    printf "  ${M}%3d${N} %s %9s  %s\n" $i "$(bar ${sizes[i]} $max 16)" "$(human ${sizes[i]})" "$(cache_label ${keys[i]})"
  done
  print "\n  ${B}$(t total "$(human $total)")${N}\n"
  local sel freed=0
  ask sel "$T[ca_pick]"
  for i in $(pick_idx "$sel" ${#keys}); do
    cache_clean ${keys[i]}
    (( freed += sizes[i] ))
    ok "$(cache_label ${keys[i]})"
  done
  rm -f $NM_LIST
  (( freed )) || return 0
  print
  log_hist m5 $freed
  celebrate "$(t ca_done "$(human $freed)")"
  [[ -z $DRY_RUN ]] && print "  ${D}$T[ca_note]${N}"
}

do_auto() {
  title "$T[m9]"
  print "  ${D}$T[au_desc]${N}\n"
  NM_LIST=$(mktemp -t mac-cleaner)
  local -a rows=( ${(f)"$(spin "$T[ca_spin]" scan_caches $SAFE_KEYS)"} )
  rows=( ${rows:#} )
  local tk=$(sizek $TRASH_DIR/*(DN)) r s total=0
  for r in $rows; do
    s=${r#*$'\t'}; (( total += s ))
    printf "  %9s  %s\n" "$(human $s)" "$(cache_label ${r%%$'\t'*})"
  done
  printf "  %9s  %s\n" "$(human $tk)" "$T[trash_title]"
  (( total += tk ))
  print "\n  ${B}$(t total "$(human $total)")${N}\n"
  confirm "$T[au_ask]" || { rm -f $NM_LIST; return 0 }
  for r in $rows; do cache_clean ${r%%$'\t'*}; done
  empty_trash
  rm -f $NM_LIST
  log_hist m9 $total
  print
  celebrate "$(t ca_done "$(human $total)")"
}

dl_scan() {
  local f
  find "$HOME/Downloads" -mindepth 1 -maxdepth 1 -not -name '.*' -mtime +$1 2>/dev/null | while IFS= read -r f; do
    print -r -- "$(sizek "$f")	$(stat -f %m "$f")	$f"
  done | sort -t$'\t' -k1,1nr | head -40
}

do_downloads() {
  title "$T[m6]"
  local days
  ask days "$T[dl_days] ${D}[90]${N}"
  [[ $days == <1-> ]] || days=90
  local -a rows=( ${(f)"$(spin "$T[dl_spin]" dl_scan $days)"} )
  rows=( ${rows:#} )
  (( ${#rows} )) || { warn "$(t dl_none $days)"; return 0 }
  local -a paths psz
  local now=$(date +%s) i=1 r sz mt p max=${rows[1]%%$'\t'*}
  for r in $rows; do
    sz=${r%%$'\t'*}; mt=${${r#*$'\t'}%%$'\t'*}; p=${r#*$'\t'*$'\t'}
    paths+=( "$p" ); psz+=( $sz )
    printf "  ${M}%3d${N} %s %9s  ${D}%6s${N}  %s\n" $i "$(bar $sz $max 12)" "$(human $sz)" "$(t dl_age $(( (now - mt) / 86400 )))" "${p:t}"
    (( i++ ))
  done
  print
  local sel k=0
  ask sel "$T[pick]"
  local -a pick
  for i in $(pick_idx "$sel" ${#paths}); do pick+=( "${paths[i]}" ); (( k += psz[i] )); done
  (( ${#pick} )) || return 0
  confirm "$(t lg_ask ${#pick} "$(human $k)")" || return 0
  to_trash $pick
  log_hist m6 $k
  celebrate "$(t lg_done "$(human $k)")"
}

st_scan() {
  local f label kind state names
  if [[ -z $MAC_CLEANER_TEST ]]; then
    names=$(osascript -e 'tell application "System Events" to get the name of every login item' 2>/dev/null)
    for f in ${(s:, :)names}; do [[ -n $f ]] && print -r -- "login	on	$f	$f"; done
  fi
  for f in $HOME/Library/LaunchAgents/*.plist /Library/LaunchAgents/*.plist /Library/LaunchDaemons/*.plist; do
    label=$(/usr/libexec/PlistBuddy -c 'Print :Label' "$f" 2>/dev/null) || label=${f:t:r}
    [[ $label == com.apple.* ]] && continue
    case $f in
      $HOME/*) kind=agent ;;
      /Library/LaunchAgents/*) kind=sysagent ;;
      *) kind=daemon ;;
    esac
    if [[ $kind == daemon ]]; then launchctl print system/$label >/dev/null 2>&1 && state=on || state=off
    else launchctl list "$label" >/dev/null 2>&1 && state=on || state=off; fi
    print -r -- "$kind	$state	$label	$f"
  done
}

st_disable() {
  local kind=$1 label=$2 f=$3
  case $kind in
    login) act_q osascript -e "tell application \"System Events\" to delete login item \"$label\"" ;;
    agent) act_q launchctl bootout gui/$UID "$f"; to_trash "$f" ;;
    sysagent) act_q sudo launchctl bootout gui/$UID "$f"; to_trash "$f" ;;
    daemon) act_q sudo launchctl bootout system "$f"; to_trash "$f" ;;
  esac
}

do_startup() {
  title "$T[m7]"
  local -a rows=( ${(f)"$(spin "$T[st_spin]" st_scan)"} )
  rows=( ${rows:#} )
  (( ${#rows} )) || { ok "$T[st_none]"; return 0 }
  local -a kinds labels files
  local i=1 r kind state label f dot
  for r in $rows; do
    kind=${r%%$'\t'*}; r=${r#*$'\t'}; state=${r%%$'\t'*}; r=${r#*$'\t'}; label=${r%%$'\t'*}; f=${r#*$'\t'}
    kinds+=( $kind ); labels+=( "$label" ); files+=( "$f" )
    [[ $state == on ]] && dot="${G}●${N}" || dot="${D}○${N}"
    printf "  ${M}%3d${N} %s  %-38s ${D}%s${N}\n" $i "$dot" "$label" "$T[st_$kind]"
    (( i++ ))
  done
  print "\n  ${D}$T[st_note]${N}\n"
  local sel
  ask sel "$T[st_pick]"
  local -a pick
  for i in $(pick_idx "$sel" ${#labels}); do pick+=( $i ); done
  (( ${#pick} )) || return 0
  confirm "$(t st_ask ${#pick})" || return 0
  if [[ -z $DRY_RUN ]] && (( ${kinds[(I)sysagent]} || ${kinds[(I)daemon]} )); then
    for i in $pick; do [[ ${kinds[i]} == (sysagent|daemon) ]] && { sudo -p "  ${D}$T[sudo_prompt]${N} " -v || return 0; break }; done
  fi
  local done_labels=()
  for i in $pick; do st_disable ${kinds[i]} "${labels[i]}" "${files[i]}"; ok "${labels[i]}"; done_labels+=( "${labels[i]}" ); done
  log_hist m7 0 "${(j:, :)done_labels}"
  print
  celebrate "$(t st_done ${#pick})"
}

du_scan() {
  local dir=$1 min=$2 size f h
  find "$dir" -xdev \( -path "$HOME/Library" -o -path "$HOME/.Trash" -o -name "*.app" -o -name node_modules -o -name .git \) -prune -o -type f -size +${min}M -print0 2>/dev/null \
    | xargs -0 stat -f $'%z\t%N' 2>/dev/null \
    | awk -F'\t' '{ c[$1]++; l[NR] = $0; s[NR] = $1 } END { for (i = 1; i <= NR; i++) if (c[s[i]] > 1) print l[i] }' \
    | while IFS=$'\t' read -r size f; do h=$(md5 -q "$f" 2>/dev/null) && print -r -- "$h	$size	$(stat -f %m "$f")	$f"; done \
    | sort -t$'\t' -k1,1 -k3,3n \
    | awk -F'\t' '{ c[$1]++; l[NR] = $0; h[NR] = $1 } END { for (i = 1; i <= NR; i++) if (c[h[i]] > 1) print l[i] }'
}

do_dupes() {
  title "$T[m8]"
  local dir min
  ask dir "$T[du_dir]"
  dir=${dir/#\~/$HOME}; dir=${dir:-$HOME}
  [[ -d $dir ]] || { err "$(t du_bad "$dir")"; return 0 }
  ask min "$T[lg_min] ${D}[1]${N}"
  [[ $min == <1-> ]] || min=1
  local -a rows=( ${(f)"$(spin "$T[du_spin]" du_scan "$dir" $min)"} )
  rows=( ${rows:#} )
  (( ${#rows} )) || { ok "$T[du_none]"; return 0 }
  local -a gstart gend
  local i prev= h
  for i in {1..${#rows}}; do
    h=${rows[i]%%$'\t'*}
    if [[ $h != $prev ]]; then (( ${#gstart} )) && gend+=( $(( i - 1 )) ); gstart+=( $i ); prev=$h; fi
  done
  gend+=( ${#rows} )
  local g j sz p
  for g in {1..${#gstart}}; do
    sz=${${rows[gstart[g]]#*$'\t'}%%$'\t'*}
    print "  ${M}$(t du_group $g $(( gend[g] - gstart[g] + 1 )) "$(human $(( sz / 1024 )))")${N}"
    for j in {${gstart[g]}..${gend[g]}}; do
      p=${rows[j]#*$'\t'*$'\t'*$'\t'}
      if (( j == gstart[g] )); then print "     ${G}$T[du_keep]${N}  ${p/#$HOME/~}"
      else print "     ${R}✘${N}      ${p/#$HOME/~}"; fi
    done
  done
  print
  local sel k=0
  ask sel "$T[du_pick]"
  local -a pick
  for g in $(pick_idx "$sel" ${#gstart}); do
    for j in {$(( gstart[g] + 1 ))..${gend[g]}}; do
      pick+=( "${rows[j]#*$'\t'*$'\t'*$'\t'}" )
      (( k += ${${rows[j]#*$'\t'}%%$'\t'*} / 1024 ))
    done
  done
  (( ${#pick} )) || return 0
  confirm "$(t du_ask ${#pick} "$(human $k)")" || return 0
  to_trash $pick
  log_hist m8 $k
  celebrate "$(t du_done "$(human $k)")"
}

do_history() {
  title "$T[mh]"
  [[ -s $HIST_FILE ]] || { warn "$T[hi_empty]"; return 0 }
  local line d a k x
  for line in ${(f)"$(tail -n 20 $HIST_FILE)"}; do
    IFS=$'\t' read -r d a k x <<< "$line"
    printf "  ${D}%s${N}  %-30s %9s  ${D}%s${N}\n" "$d" "$T[$a]" "$( (( k )) && human $k || print -n -)" "$x"
  done
  print "\n  ${B}$(t hi_total "$(human $(awk -F'\t' '{s+=$3} END{print s+0}' $HIST_FILE))")${N}"
}

menu_item() { printf "  ${D}│${N}  ${M}%s${N}  ${B}%s${N}  %-38s${D}│${N}\n" "$1" "$2" "$3" }

menu() {
  local first=1 c=
  while true; do
    [[ -n $FANCY ]] && print -n "\e[H\e[2J"
    print
    draw_logo $(( first ? 10 : 1 )); first=0
    overview
    [[ -n $DRY_RUN ]] && print "\n  ${Y}✦ $T[dry_badge]${N}"
    print "\n  ${D}╭──────────────────────────────────────────────╮${N}"
    menu_item ✦ 1 "$T[m1]"
    menu_item ✧ 2 "$T[m2]"
    menu_item ✦ 3 "$T[m3]"
    menu_item ✧ 4 "$T[m4]"
    menu_item ✦ 5 "$T[m5]"
    menu_item ✧ 6 "$T[m6]"
    menu_item ✦ 7 "$T[m7]"
    menu_item ✧ 8 "$T[m8]"
    menu_item ✦ 9 "$T[m9]"
    menu_item ✧ h "$T[mh]"
    menu_item ⋆ q "$T[mq]"
    print "  ${D}╰──────────────────────────────────────────────╯${N}\n"
    c=
    key c "  ${M}›${N} " || exit 0
    print "$c"
    case $c in
      1) do_ram ;;
      2) do_trash ;;
      3) do_uninstall ;;
      4) do_large ;;
      5) do_caches ;;
      6) do_downloads ;;
      7) do_startup ;;
      8) do_dupes ;;
      9) do_auto ;;
      h|H) do_history ;;
      q|Q) print "  ${Y}✦${N} ${D}$T[bye]${N}\n"; exit 0 ;;
      *) continue ;;
    esac
    print
    pause
  done
}

usage() {
  print "$(t usage $SCRIPT)\n"
  printf "  %-14s %s\n" ram "$T[u_ram]" trash "$T[u_trash]" uninstall "$T[u_un]" large "$T[u_lg]" caches "$T[u_ca]" \
    downloads "$T[u_dl]" startup "$T[u_st]" duplicates "$T[u_du]" auto "$T[u_auto]" history "$T[u_hist]"
  print "  $T[u_menu]\n"
  print "  $T[u_dry]\n  $T[u_yes]"
}

case $CMD in
  ram) do_ram ;;
  corbeille|trash) do_trash ;;
  desinstaller|uninstall) do_uninstall ;;
  gros|large) do_large ;;
  caches) do_caches ;;
  telechargements|downloads) do_downloads ;;
  demarrage|startup) do_startup ;;
  doublons|duplicates) do_dupes ;;
  auto) do_auto ;;
  historique|history) do_history ;;
  ""|menu) menu ;;
  -v|--version) print "mac-cleaner $VERSION" ;;
  -h|--help) usage ;;
  *) usage; exit 1 ;;
esac
