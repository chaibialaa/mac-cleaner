#!/bin/zsh
setopt null_glob extended_glob

VERSION=1.1.0
SCRIPT=${0:t}

DRY_RUN= YES= CMD=
for a in "$@"; do
  case $a in
    -n|--dry-run) DRY_RUN=1 ;;
    -y|--yes) YES=1 ;;
    *) [[ -z $CMD ]] && CMD=$a ;;
  esac
done

if [[ -t 1 && -z $NO_COLOR ]]; then
  FANCY=1
  B=$'\e[1m' D=$'\e[2m' G=$'\e[38;5;114m' Y=$'\e[38;5;221m' R=$'\e[38;5;203m' C=$'\e[38;5;81m' M=$'\e[38;5;177m' N=$'\e[0m'
else
  FANCY= B= D= G= Y= R= C= M= N=
fi
GRAD=(51 45 39 33 63 99 135 171 207 213)
STARS=(✦ ✧ ⋆ · ✶ · ⋆ ✧)
[[ -n $FANCY ]] && trap 'print -n "\e[?25h"' EXIT
trap '[[ -n $FANCY ]] && print -n "\e[?25h"; print; exit 130' INT

TRASH_DIR=${MAC_CLEANER_TRASH_DIR:-$HOME/.Trash}
HIST_FILE=${XDG_STATE_HOME:-$HOME/.local/state}/mac-cleaner/history.tsv
NM_LIST=

LANG_UI=${MAC_CLEANER_LANG:-$(defaults read -g AppleLanguages 2>/dev/null | awk -F'"' 'NF>1{print substr($2,1,2); exit}')}
[[ $LANG_UI == fr ]] || LANG_UI=en

typeset -A T
if [[ $LANG_UI == fr ]]; then
  T=(
    gb Go mb Mo kb Ko yes '[oOyY]*' yn o/N all_key '[tT]*'
    tagline "le ménage de ton Mac, en grandes lignes"
    disk Disque ram RAM disk_free "%s libres" ram_free "%s%% libre"
    m1 "Libérer la RAM" m2 "Vider la corbeille" m3 "Désinstaller une application"
    m4 "Chercher les gros fichiers" m5 "Nettoyer les caches" m6 "Vieux téléchargements"
    m7 "Démarrage (apps et services)" m8 "Fichiers en double" m9 "Nettoyage auto" mh Historique
    mq Quitter bye "À bientôt."
    back "[ une touche pour revenir au menu ]"
    dry_badge "APERÇU · rien ne sera supprimé" dry_line "[aperçu] %s" dry_done "Aperçu terminé : rien n'a été supprimé."
    ram_free_now "Mémoire libre : %s%%" top_procs "Processus les plus gourmands"
    ram_ask "Libérer la mémoire inactive (sudo purge) ?" sudo_prompt "mot de passe admin :"
    ram_spin "Purge de la mémoire…" ram_done "RAM libre : %s%% → %s%%"
    trash_title Corbeille trash_spin "Mesure de la corbeille…" trash_size "Taille de la corbeille : %s"
    trash_zero "(0 peut aussi vouloir dire que le Terminal n'a pas l'accès complet au disque)"
    trash_ask "Vider la corbeille (définitif) ?" trash_emptying "Vidage…" trash_done "Corbeille vidée · %s récupérés"
    trash_fail "Échec : autorise le Terminal à piloter le Finder (Réglages › Confidentialité › Automatisation)."
    un_filter "Nom (ou partie du nom), vide = toutes" un_none "Aucune app trouvée."
    un_pick "Numéro de l'app (vide = annuler)" un_apple "App système Apple, ignorée."
    un_spin "Recherche des fichiers de %s…" total "Total : %s"
    un_ask "Mettre tout cela à la corbeille ?" un_done "%s désinstallée · %s (récupérable dans la corbeille)"
    mv_fail "Impossible de déplacer : %s"
    lg_min "Taille minimale en Mo" lg_spin "Exploration de ~ (hors ~/Library)…"
    lg_none "Aucun fichier de plus de %s Mo." pick "Numéros à mettre à la corbeille (ex. 1 3 5), « t » = tout, vide = rien"
    lg_ask "Mettre %s fichier(s) (%s) à la corbeille ?" lg_done "%s envoyés à la corbeille"
    ca_title "Caches et fichiers temporaires" ca_spin "Analyse des caches…"
    ca_pick "Numéros à nettoyer (ex. 1 3), « t » = tout, vide = rien"
    ca_done "Environ %s libérés" ca_note "(les apps ouvertes recréent une partie de leurs caches)"
    c_apps "Caches des apps" c_logs "Journaux (logs)" c_xcode "Xcode DerivedData" c_devsupport "Xcode iOS DeviceSupport"
    c_sim "Caches simulateurs iOS" c_npm "Cache npm" c_composer "Cache Composer" c_gradle "Caches Gradle"
    c_brew "Homebrew (anciennes versions, téléchargements)" c_docker "Docker (images inutilisées, conteneurs arrêtés)"
    c_nodemod "node_modules inactifs depuis 90 j (%s projet(s))"
    au_desc "Seulement ce qui est sans risque : caches, journaux, caches de dev, Homebrew, corbeille."
    au_ask "Tout nettoyer ?"
    dl_days "Plus vieux que combien de jours" dl_spin "Exploration de ~/Downloads…"
    dl_none "Aucun élément de plus de %s jours dans Téléchargements." dl_age "%s j"
