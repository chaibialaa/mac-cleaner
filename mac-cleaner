#!/bin/zsh
setopt null_glob extended_glob

VERSION=1.0.0
SCRIPT=${0:t}

if [[ -t 1 && -z $NO_COLOR ]]; then
  FANCY=1
  B=$'\e[1m' D=$'\e[2m' G=$'\e[38;5;114m' Y=$'\e[38;5;221m' R=$'\e[38;5;203m' C=$'\e[38;5;81m' M=$'\e[38;5;177m' N=$'\e[0m'
else
  FANCY= B= D= G= Y= R= C= M= N=
fi
GRAD=(51 45 39 33 63 99 135 171 207 213)
STARS=(✦ ✧ ⋆ · ✶ · ⋆ ✧)
[[ -n $FANCY ]] && trap 'print -n "\e[?25h"' EXIT
trap '[[ -n $FANCY ]] && print -n "\e[?25h"; print; exit 130' INT

LANG_UI=${MAC_CLEANER_LANG:-$(defaults read -g AppleLanguages 2>/dev/null | awk -F'"' 'NF>1{print substr($2,1,2); exit}')}
[[ $LANG_UI == fr ]] || LANG_UI=en

typeset -A T
if [[ $LANG_UI == fr ]]; then
  T=(
    gb Go mb Mo kb Ko yes '[oOyY]*' yn o/N
    tagline "le ménage de ton Mac, en grandes lignes"
    disk Disque ram RAM disk_free "%s libres" ram_free "%s%% libre"
    m1 "Libérer la RAM" m2 "Vider la corbeille" m3 "Désinstaller une application"
    m4 "Chercher les gros fichiers" m5 "Nettoyer les caches" mq Quitter bye "À bientôt."
    back "[ une touche pour revenir au menu ]"
    ram_free_now "Mémoire libre : %s%%" top_procs "Processus les plus gourmands"
    ram_ask "Libérer la mémoire inactive (sudo purge) ?" sudo_prompt "mot de passe admin :"
    ram_spin "Purge de la mémoire…" ram_done "RAM libre : %s%% → %s%%"
    trash_title Corbeille trash_spin "Mesure de la corbeille…" trash_size "Taille de la corbeille : %s"
    trash_zero "(0 peut aussi vouloir dire que le Terminal n'a pas l'accès complet au disque)"
    trash_ask "Vider la corbeille (définitif) ?" trash_emptying "Vidage…" trash_done "Corbeille vidée · %s récupérés"
    trash_fail "Échec : autorise le Terminal à piloter le Finder (Réglages › Confidentialité › Automatisation)."
    un_filter "Nom (ou partie du nom), vide = toutes" un_none "Aucune app trouvée."
    un_pick "Numéro de l'app (vide = annuler)" un_apple "App système Apple, ignorée."
    un_spin "Recherche des fichiers de %s…" total "Total : %s"
    un_ask "Mettre tout cela à la corbeille ?" un_done "%s désinstallée · %s (récupérable dans la corbeille)"
    mv_fail "Impossible de déplacer : %s"
    lg_title "Gros fichiers" lg_min "Taille minimale en Mo" lg_spin "Exploration de ~ (hors ~/Library)…"
    lg_none "Aucun fichier de plus de %s Mo." lg_pick "Numéros à mettre à la corbeille (ex. 1 3 5), vide = rien"
    lg_ask "Mettre %s fichier(s) (%s) à la corbeille ?" lg_done "%s envoyés à la corbeille"
    ca_title "Caches et fichiers temporaires" ca_spin "Analyse des caches…"
    ca_pick "Numéros à nettoyer (ex. 1 3), « t » = tout, vide = rien" all_key '[tT]*'
    ca_done "Environ %s libérés" ca_note "(les apps ouvertes recréent une partie de leurs caches)"
    c1 "Caches des apps" c2 "Journaux (logs)" c3 "Xcode DerivedData" c4 "Caches simulateurs iOS" c5 "Cache npm" c6 "Cache Composer"
    usage "Usage : %s [commande]"
    u_ram "libérer la mémoire inactive" u_trash "vider la corbeille" u_un "désinstaller une app et ses fichiers"
    u_lg "chercher les gros fichiers" u_ca "nettoyer les caches" u_menu "(sans argument : menu interactif)"
  )
else
  T=(
    gb GB mb MB kb KB yes '[yY]*' yn y/N
    tagline "tidy up your Mac, the essentials"
    disk Disk ram RAM disk_free "%s free" ram_free "%s%% free"
    m1 "Free up RAM" m2 "Empty the Trash" m3 "Uninstall an app"
    m4 "Find large files" m5 "Clean caches" mq Quit bye "See you soon."
    back "[ press any key to return to the menu ]"
    ram_free_now "Free memory: %s%%" top_procs "Top memory consumers"
    ram_ask "Free inactive memory (sudo purge)?" sudo_prompt "admin password:"
    ram_spin "Purging memory…" ram_done "Free RAM: %s%% → %s%%"
    trash_title Trash trash_spin "Measuring the Trash…" trash_size "Trash size: %s"
    trash_zero "(0 may also mean Terminal lacks Full Disk Access)"
    trash_ask "Empty the Trash (permanent)?" trash_emptying "Emptying…" trash_done "Trash emptied · %s reclaimed"
    trash_fail "Failed: allow Terminal to control Finder (Settings › Privacy › Automation)."
    un_filter "Name (or part of it), empty = all" un_none "No app found."
    un_pick "App number (empty = cancel)" un_apple "Apple system app, skipped."
    un_spin "Looking for %s files…" total "Total: %s"
    un_ask "Move all of this to the Trash?" un_done "%s uninstalled · %s (recoverable from the Trash)"
    mv_fail "Could not move: %s"
    lg_title "Large files" lg_min "Minimum size in MB" lg_spin "Scanning ~ (excluding ~/Library)…"
    lg_none "No file larger than %s MB." lg_pick "Numbers to move to the Trash (e.g. 1 3 5), empty = none"
    lg_ask "Move %s file(s) (%s) to the Trash?" lg_done "%s moved to the Trash"
    ca_title "Caches and temporary files" ca_spin "Analyzing caches…"
    ca_pick "Numbers to clean (e.g. 1 3), \"a\" = all, empty = none" all_key '[aA]*'
    ca_done "About %s freed" ca_note "(running apps will rebuild part of their caches)"
    c1 "App caches" c2 "Logs" c3 "Xcode DerivedData" c4 "iOS Simulator caches" c5 "npm cache" c6 "Composer cache"
    usage "Usage: %s [command]"
    u_ram "free inactive memory" u_trash "empty the Trash" u_un "uninstall an app and its files"
    u_lg "find large files" u_ca "clean caches" u_menu "(no argument: interactive menu)"
  )
fi

t() { local k=$1; shift; printf -- "$T[$k]" "$@" }

human() {
  local k=${1:-0}
  if (( k >= 1048576 )); then printf "%.1f $T[gb]" $(( k / 1048576.0 ))
  elif (( k >= 1024 )); then printf "%.1f $T[mb]" $(( k / 1024.0 ))
  else printf "%d $T[kb]" $k; fi
}

sizek() { (( $# )) || { echo 0; return }; du -sk "$@" 2>/dev/null | awk '{s+=$1} END{print s+0}' }

bar() {
  local val=$1 max=$2 width=${3:-20} col=${4:-$C}
  (( max > 0 )) || max=1
  local fill=$(( val * width / max ))
  (( val > 0 && fill == 0 )) && fill=1
  (( fill > width )) && fill=$width
  print -n "${col}${(l:fill::█:)}${N}${D}${(l:width-fill::░:)}${N}"
}

gauge_col() { (( $1 >= 85 )) && print -n $R || { (( $1 >= 60 )) && print -n $Y || print -n $G } }

star_line() {
  local w=${1:-44} line="" i
  for (( i = 0; i < w; i++ )); do
    if (( RANDOM % 9 == 0 )); then
      line+="\e[38;5;$(( RANDOM % 2 ? 228 : 255 ))m${STARS[RANDOM % ${#STARS} + 1]}${N}"
    else
      line+=" "
    fi
  done
  print -n "  $line"
}

LOGO=(
  "┌┬┐┌─┐┌─┐   ┌─┐┬  ┌─┐┌─┐┌┐┌┌─┐┬─┐"
  "│││├─┤│  ───│  │  ├┤ ├─┤│││├┤ ├┬┘"
  "┴ ┴┴ ┴└─┘   └─┘┴─┘└─┘┴ ┴┘└┘└─┘┴└─"
)

logo_lines() {
  local l i w=${#LOGO[1]} out
  for l in $LOGO; do
    out="     "
    for (( i = 1; i <= ${#l}; i++ )); do
      if [[ -n $FANCY ]]; then out+="\e[38;5;${GRAD[(i - 1) * ${#GRAD} / w + 1]}m${l[i]}"
      else out+=${l[i]}; fi
    done
    print "$out${N}"
  done
}

draw_logo() {
  if [[ -z $FANCY ]]; then logo_lines; return; fi
  local logo=$(logo_lines) f frames=${1:-1}
  print -n "\e[?25l"
  for (( f = 1; f <= frames; f++ )); do
    (( f > 1 )) && print -n "\e[6A"
    star_line; print
    print "$logo"
    star_line; print
    print "     ${D}v$VERSION · $T[tagline]${N}"
    (( f < frames )) && sleep 0.07
  done
  print -n "\e[?25h"
}

spin() {
  local msg=$1; shift
  if [[ -z $FANCY ]]; then "$@"; return; fi
  local tmp=$(mktemp -t mac-cleaner)
  "$@" >$tmp 2>/dev/null &
  local pid=$! i=0 frames=(✶ ✷ ✸ ✹ ✺ ✹ ✸ ✷)
  print -n "\e[?25l" >&2
  while kill -0 $pid 2>/dev/null; do
    printf "\r  ${Y}%s${N} ${D}%s${N}" $frames[$(( i++ % ${#frames} + 1 ))] "$msg" >&2
    sleep 0.08
  done
  wait $pid
  print -n "\r\e[2K\e[?25h" >&2
  cat $tmp; rm -f $tmp
}

confirm() { local r; read "r?  ${M}?${N} $1 ${D}($T[yn])${N} ${M}›${N} "; [[ $r == ${~T[yes]} ]] }

ask() { local __v; read "__v?  ${M}?${N} $2 ${M}›${N} "; : ${(P)1::=$__v} }

pause() { local r; read -s -k1 -u0 "r?  ${D}$T[back]${N}"; print }

title() {
  local t=" ✦ $1 " w=56
  print "\n  ${M}${B}${t}${N}${D}${(l:w-${#t}::─:)}${N}\n"
}

ok() { print "  ${G}✔${N} $*" }
warn() { print "  ${Y}!${N} $*" }
err() { print "  ${R}✘${N} $*" }

celebrate() {
  local msg=$1 f
  if [[ -z $FANCY ]]; then print "  * $msg *"; return; fi
  local -a cols=(228 221 215 213 177 141 117 228)
  print -n "\e[?25l"
  for f in {1..8}; do
    printf "\r  \e[38;5;%dm★ ✦ ⋆${N}  ${B}%s${N}  \e[38;5;%dm⋆ ✦ ★${N}" $cols[f] "$msg" $cols[9 - f]
    sleep 0.06
  done
  print "\e[?25h"
}

to_trash() {
  local p
  for p in "$@"; do
    [[ -e $p ]] || continue
    trash "$p" 2>/dev/null || osascript -e "tell application \"Finder\" to delete POSIX file \"$p\"" >/dev/null 2>&1 \
      || err "$(t mv_fail "$p")"
  done
}

disk_stats() { df -k /System/Volumes/Data | awk 'NR==2{print $2, $4}' }

mem_free() { memory_pressure 2>/dev/null | awk -F': ' '/free percentage/{gsub("%","",$2); print $2}' }

overview() {
  local -a ds=( $(disk_stats) )
  local dpct=$(( (ds[1] - ds[2]) * 100 / ds[1] )) mfree=$(mem_free)
  local mpct=$(( 100 - ${mfree:-0} ))
  printf "\n  ${D}%-6s${N}  %s ${B}%3d%%${N} ${D}· %s${N}\n" "$T[disk]" "$(bar $dpct 100 24 $(gauge_col $dpct))" $dpct "$(t disk_free "$(human $ds[2])")"
  printf "  ${D}%-6s${N}  %s ${B}%3d%%${N} ${D}· %s${N}\n" "$T[ram]" "$(bar $mpct 100 24 $(gauge_col $mpct))" $mpct "$(t ram_free "$mfree")"
}

do_ram() {
  title "$T[ram]"
  local before=$(mem_free)
  print "  ${B}$(t ram_free_now $before)${N}\n"
  print "  ${D}$T[top_procs]${N}"
  local -a procs=( ${(f)"$(ps -axmo rss=,comm= | head -8)"} )
  local max=${${procs[1]## #}%% *} p rss cmd
  for p in $procs; do
    rss=${${p## #}%% *}; cmd=${${p## #}#* }
    printf "  %s %9s  %s\n" "$(bar $rss $max 16 $M)" "$(human $rss)" "${cmd:t}"
  done
  print
  confirm "$T[ram_ask]" || return 0
  sudo -p "  ${D}$T[sudo_prompt]${N} " true || return 0
  spin "$T[ram_spin]" sudo purge
  celebrate "$(t ram_done $before $(mem_free))"
}

do_trash() {
  title "$T[trash_title]"
  local k=$(spin "$T[trash_spin]" sizek ~/.Trash/*(DN))
  print "  $(t trash_size "${B}$(human $k)${N}")"
  (( k == 0 )) && print "  ${D}$T[trash_zero]${N}"
  print
  confirm "$T[trash_ask]" || return 0
  if spin "$T[trash_emptying]" osascript -e 'tell application "Finder" to empty trash' >/dev/null; then
    celebrate "$(t trash_done "$(human $k)")"
  else
    err "$T[trash_fail]"
  fi
}

LIB_DIRS=(
  ~/Library/"Application Support" ~/Library/Caches ~/Library/Preferences ~/Library/Containers
  ~/Library/"Group Containers" ~/Library/Logs ~/Library/"Saved Application State" ~/Library/HTTPStorages
  ~/Library/WebKit ~/Library/LaunchAgents ~/Library/Cookies ~/Library/"Application Scripts"
  /Library/"Application Support" /Library/Caches /Library/Preferences /Library/LaunchAgents /Library/LaunchDaemons
)

leftovers() {
  local app=$1 name=$2 bid=$3 d
  local -a expr
  [[ -n $bid ]] && expr=( -name "$bid" -o -name "$bid.*" -o -name "*.$bid" -o -name "*.$bid.*" -o )
  print -r -- "$app"
  for d in $LIB_DIRS; do
    [[ -d $d ]] || continue
    find "$d" -mindepth 1 -maxdepth 1 \( $expr -iname "$name" -o -iname "$name.*" \) 2>/dev/null
  done
}

do_uninstall() {
  title "$T[m3]"
  local filter
  ask filter "$T[un_filter]"
  local -a apps
  apps=( /Applications/*.app ~/Applications/*.app )
  [[ -n $filter ]] && apps=( ${(M)apps:#(#i)*${filter}*} )
  (( ${#apps} )) || { warn "$T[un_none]"; return 0 }
  print
  local i=1 a
  for a in $apps; do printf "  ${M}%3d${N}  %s\n" $i "${a:t:r}"; (( i++ )); done
  print
  local n
  ask n "$T[un_pick]"
  [[ $n == <1-> && $n -le ${#apps} ]] || return 0
  local app=$apps[$n] name=${apps[$n]:t:r}
  local bid=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist" 2>/dev/null)
  [[ $bid == com.apple.* ]] && { err "$T[un_apple]"; return 0 }

  local -a found=( ${(u)${(f)"$(spin "$(t un_spin $name)" leftovers "$app" "$name" "$bid")"}:#} )
  local -a sizes
  local f max=0 total=0 k
  for f in $found; do k=$(sizek "$f"); sizes+=( $k ); (( total += k, k > max ? (max = k) : 0 )); done

  print "\n  ${B}$name${N} ${D}· $bid${N}\n"
  for i in {1..${#found}}; do
    printf "  %s %9s  %s\n" "$(bar $sizes[i] $max 12)" "$(human $sizes[i])" "${found[i]/#$HOME/~}"
  done
  print "\n  ${B}$(t total "$(human $total)")${N}\n"
  confirm "$T[un_ask]" || return 0
  [[ -n $bid ]] && osascript -e "quit app id \"$bid\"" >/dev/null 2>&1
  to_trash $found
  celebrate "$(t un_done $name "$(human $total)")"
}

large_scan() {
  local min=$1 f
  find "$HOME" -xdev \( -path "$HOME/Library" -o -path "$HOME/.Trash" -o -name "*.app" \) -prune -o -type f -size +${min}M -print 2>/dev/null \
    | while IFS= read -r f; do print -r -- "$(stat -f '%z' "$f")	$f"; done \
    | sort -t$'\t' -k1,1nr | head -40
}

do_large() {
  title "$T[lg_title]"
  local min
  ask min "$T[lg_min] ${D}[500]${N}"
  [[ $min == <1-> ]] || min=500
  local -a rows=( ${(f)"$(spin "$T[lg_spin]" large_scan $min)"} )
  (( ${#rows} )) || { warn "$(t lg_none $min)"; return 0 }
  local -a paths
  local i=1 r max=${rows[1]%%$'\t'*} sz
  for r in $rows; do
    paths+=( "${r#*$'\t'}" ); sz=${r%%$'\t'*}
    printf "  ${M}%3d${N} %s %9s  %s\n" $i "$(bar $(( sz / 1024 )) $(( max / 1024 )) 12)" "$(human $(( sz / 1024 )))" "${${r#*$'\t'}/#$HOME/~}"
    (( i++ ))
  done
  print
  local sel
  ask sel "$T[lg_pick]"
  local -a pick
  for i in ${=sel}; do [[ $i == <1-> && $i -le ${#paths} ]] && pick+=( "$paths[$i]" ); done
  (( ${#pick} )) || return 0
  local k=$(sizek $pick)
  confirm "$(t lg_ask ${#pick} "$(human $k)")" || return 0
  to_trash $pick
  celebrate "$(t lg_done "$(human $k)")"
}

CACHE_DIRS=( ~/Library/Caches ~/Library/Logs ~/Library/Developer/Xcode/DerivedData ~/Library/Developer/CoreSimulator/Caches ~/.npm/_cacache ~/.composer/cache )

cache_sizes() { local d; for d in $CACHE_DIRS; do sizek $d/*(DN); done }

do_caches() {
  title "$T[ca_title]"
  local -a sizes=( ${(f)"$(spin "$T[ca_spin]" cache_sizes)"} )
  local i total=0 max=0
  for i in {1..${#CACHE_DIRS}}; do (( total += sizes[i], sizes[i] > max ? (max = sizes[i]) : 0 )); done
  for i in {1..${#CACHE_DIRS}}; do
    printf "  ${M}%3d${N} %s %9s  %s\n" $i "$(bar $sizes[i] $max 16)" "$(human $sizes[i])" "$T[c$i]"
  done
  print "\n  ${B}$(t total "$(human $total)")${N}\n"
  local sel
  ask sel "$T[ca_pick]"
  [[ -z $sel ]] && return 0
  [[ $sel == ${~T[all_key]} ]] && sel=$(seq -s ' ' 1 ${#CACHE_DIRS})
  local freed=0 d
  for i in ${=sel}; do
    [[ $i == <1-> && $i -le ${#CACHE_DIRS} ]] || continue
    d=$CACHE_DIRS[i]
    [[ -d $d && $d == $HOME/?* ]] || continue
    rm -rf "$d"/*(DN) 2>/dev/null
    (( freed += sizes[i] ))
    ok "$T[c$i]"
  done
  print
  celebrate "$(t ca_done "$(human $freed)")"
  print "  ${D}$T[ca_note]${N}"
}

menu_item() { printf "  ${D}│${N}  ${M}%s${N}  ${B}%s${N}  %-38s${D}│${N}\n" "$1" "$2" "$3" }

menu() {
  local first=1
  while true; do
    [[ -n $FANCY ]] && print -n "\e[H\e[2J"
    print
    draw_logo $(( first ? 10 : 1 )); first=0
    overview
    print "\n  ${D}╭──────────────────────────────────────────────╮${N}"
    menu_item ✦ 1 "$T[m1]"
    menu_item ✧ 2 "$T[m2]"
    menu_item ✦ 3 "$T[m3]"
    menu_item ✧ 4 "$T[m4]"
    menu_item ✦ 5 "$T[m5]"
    menu_item ⋆ q "$T[mq]"
    print "  ${D}╰──────────────────────────────────────────────╯${N}\n"
    local c
    read -k1 -u0 "c?  ${M}›${N} " || exit 0
    print
    case $c in
      1) do_ram ;;
      2) do_trash ;;
      3) do_uninstall ;;
      4) do_large ;;
      5) do_caches ;;
      q|Q) print "  ${Y}✦${N} ${D}$T[bye]${N}\n"; exit 0 ;;
      *) continue ;;
    esac
    print
    pause
  done
}

usage() {
  print "$(t usage $SCRIPT)\n"
  printf "  %-14s %s\n" "ram" "$T[u_ram]" "trash" "$T[u_trash]" "uninstall" "$T[u_un]" "large" "$T[u_lg]" "caches" "$T[u_ca]"
  print "  $T[u_menu]"
}

case $1 in
  ram) do_ram ;;
  corbeille|trash) do_trash ;;
  desinstaller|uninstall) do_uninstall ;;
  gros|large) do_large ;;
  caches) do_caches ;;
  ""|menu) menu ;;
  -v|--version) print "mac-cleaner $VERSION" ;;
  -h|--help) usage ;;
  *) usage; exit 1 ;;
esac
